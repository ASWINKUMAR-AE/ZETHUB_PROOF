# ---------------------------------------------------------------------------
# ZetHub Proof environment template. Copy to .env and fill in real values.
# Never commit .env. The application never overwrites an existing .env.
# ---------------------------------------------------------------------------
NODE_ENV=development

# Local API. Bind to loopback only unless you understand the security impact.
API_HOST=127.0.0.1
API_PORT=4000
# Comma separated list of allowed browser origins for the local API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,tauri://localhost,http://tauri.localhost

# --- XAMPP / MySQL -----------------------------------------------------------
# MySQL-compatible server bundled with XAMPP (MariaDB is supported).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=zethub_proof
# Least-privilege application account created by `npm run db:setup`.
DB_USER=zethub_proof_app
DB_PASSWORD=
DB_CONNECTION_TIMEOUT=10000

# Optional administrative account used ONLY by the bootstrap command.
# Leave empty to let setup prompt / use phpMyAdmin SQL fallback.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=
# Path to the XAMPP installation. Leave empty for auto-detection.
XAMPP_HOME=

# Prisma connection string. Generated from the DB_* values when empty.
DATABASE_URL=

# --- Verification ------------------------------------------------------------
ARTIFACTS_DIR=./artifacts
# Keep at 1 when project scripts rebuild shared outputs (build, typecheck, e2e).
MAX_PARALLEL_TESTS=1
DEFAULT_COMMAND_TIMEOUT_MS=300000
ARTIFACT_RETENTION_DAYS=30
# Directory the API is allowed to browse for project registration.
WORKSPACE_ROOTS=

# --- Security ----------------------------------------------------------------
# 32+ random characters. Generated on first run if absent.
SESSION_SECRET=
# Set to true only when the desktop shell injects a trusted device header.
TRUST_LOCAL_DEVICE=false

# --- Optional AI provider (disabled unless configured) -----------------------
AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_CONSENT_SEND_CODE=false

# --- Optional integrations ---------------------------------------------------
GITHUB_TOKEN=

# --- Automatic updates (disabled until a public key is configured) -----------
# Update store containing releases/ and artifacts/. Never place private keys here.
UPDATE_STORAGE_DIR=./data/updates
# Public HTTPS origin of the central update service. Leave empty for local-only feeds.
# Example: https://updates.YOUR-DOMAIN.example/zethub-proof
UPDATE_FEED_URL=
# Public origin used in download URLs served by the update service.
UPDATE_PUBLIC_BASE_URL=
# Client-side verification key. Prefer the file; keep the private key off client machines.
UPDATE_SIGNING_PUBLIC_KEY=
UPDATE_SIGNING_PUBLIC_KEY_PATH=./secrets/update-signing-public.pem
# Release/CI machine only. Never commit or ship this file.
UPDATE_SIGNING_PRIVATE_KEY_PATH=./secrets/update-signing-private.pem
# Header token required to serve the beta channel from the public feed.
UPDATE_BETA_FEED_TOKEN=
# manual: verified package is handed to the user; windows-installer: launch a signed installer with consent.
UPDATE_INSTALL_MODE=manual
UPDATE_CHECK_TIMEOUT_MS=10000
UPDATE_MAX_ARTIFACT_MB=512
# Standalone central update service (scripts/update-server.mjs).
UPDATE_SERVER_HOST=127.0.0.1
UPDATE_SERVER_PORT=4010
